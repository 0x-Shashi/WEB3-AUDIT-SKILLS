## 6. ERC721/1155 Reentrancy

Safe transfer functions call receiver hooks.

```solidity
// VULNERABLE
contract VulnerableNFTMarket {
    function buy(uint256 tokenId) external payable {
        require(msg.value >= prices[tokenId], "Insufficient payment");
        
        // onERC721Received callback enables reentrancy
        nft.safeTransferFrom(address(this), msg.sender, tokenId);
        
        // State update after callback
        delete listings[tokenId];
    }
}

// SECURE: Update state before transfer
contract SecureNFTMarket {
    function buy(uint256 tokenId) external payable {
        require(msg.value >= prices[tokenId], "Insufficient payment");
        
        delete listings[tokenId];  // BEFORE transfer
        nft.safeTransferFrom(address(this), msg.sender, tokenId);
    }
}
```

