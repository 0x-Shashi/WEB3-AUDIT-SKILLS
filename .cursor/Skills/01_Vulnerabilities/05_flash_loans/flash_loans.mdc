# ⚡ Flash Loan Vulnerabilities

## Overview

Flash loans enable borrowing unlimited funds without collateral, as long as they're repaid within the same transaction. This creates novel attack vectors where attackers can temporarily control massive capital.

---

## 1. Governance Flash Loan Attacks

### Token-Weighted Voting

```solidity
// VULNERABLE - voting power from current balance
contract VulnerableGovernance {
    IERC20 public governanceToken;
    
    function vote(uint256 proposalId, bool support) external {
        uint256 votingPower = governanceToken.balanceOf(msg.sender);  // Current balance!
        votes[proposalId] += support ? int256(votingPower) : -int256(votingPower);
    }
}

// ATTACK:
// 1. Flash loan 10M tokens
// 2. Vote on proposal with massive weight
// 3. Return tokens in same tx
// Proposal passes with borrowed voting power!

// SECURE - snapshot-based voting
import "@openzeppelin/contracts/token/ERC20/extensions/ERC20Votes.sol";

contract SecureGovernance {
    ERC20Votes public governanceToken;
    mapping(uint256 => uint256) public proposalSnapshots;
    
    function createProposal() external returns (uint256 proposalId) {
        proposalId = proposalCount++;
        proposalSnapshots[proposalId] = block.number;  // Snapshot at creation
    }
    
    function vote(uint256 proposalId, bool support) external {
        uint256 snapshot = proposalSnapshots[proposalId];
        // Use PAST balance, not current
        uint256 votingPower = governanceToken.getPastVotes(msg.sender, snapshot);
        // ...
    }
}
```

