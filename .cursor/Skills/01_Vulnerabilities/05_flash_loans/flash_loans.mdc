## 3. Reward/Yield Farming Attack

```solidity
// VULNERABLE - rewards based on current stake
contract VulnerableStaking {
    function claimRewards() external {
        uint256 pending = (balances[msg.sender] * rewardRate * timePassed) / totalStaked;
        rewardToken.transfer(msg.sender, pending);
    }
}

// ATTACK:
// 1. Flash loan tokens
// 2. Stake flash loaned tokens (become 99% of pool)
// 3. Claim rewards (get 99% of all pending rewards)
// 4. Unstake and return flash loan

// SECURE - time-based vesting
contract SecureStaking {
    mapping(address => uint256) public stakeTimestamp;
    uint256 public constant MIN_STAKE_DURATION = 1 hours;
    
    function stake(uint256 amount) external {
        require(stakeTimestamp[msg.sender] == 0 || 
                block.timestamp - stakeTimestamp[msg.sender] >= MIN_STAKE_DURATION);
        stakeTimestamp[msg.sender] = block.timestamp;
        // ... stake
    }
    
    function claimRewards() external {
        require(block.timestamp - stakeTimestamp[msg.sender] >= MIN_STAKE_DURATION);
        // ... claim
    }
}
