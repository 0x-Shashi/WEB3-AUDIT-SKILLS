## 8. Flash Loan Fee-on-Transfer Issues

```solidity
// VULNERABLE - doesn't account for fee-on-transfer
function executeFlashLoan(IERC20 token, uint256 amount) external {
    uint256 balanceBefore = token.balanceOf(address(this));
    
    // Flash loan amount
    flashLender.flashLoan(token, amount);
    
    // Execute callback
    _doOperation();
    
    // Repay (but received less due to fee!)
    token.transfer(address(flashLender), amount);  // FAILS - not enough!
    
    require(token.balanceOf(address(this)) >= balanceBefore);
}

// SECURE - measure actual received
function executeFlashLoan(IERC20 token, uint256 amount) external {
    uint256 balanceBefore = token.balanceOf(address(this));
    
    flashLender.flashLoan(token, amount);
    
    uint256 received = token.balanceOf(address(this)) - balanceBefore;
    
    _doOperation(received);  // Work with actual received amount
    
    // Repay what we actually need to
    uint256 repayAmount = flashLender.flashFee(token, amount) + received;
    token.transfer(address(flashLender), repayAmount);
}
```

