## 5. Share/Token Ratio Manipulation

```solidity
// VULNERABLE vault (first depositor attack)
contract VulnerableVault {
    function deposit(uint256 assets) external returns (uint256 shares) {
        if (totalSupply == 0) {
            shares = assets;
        } else {
            shares = assets * totalSupply / totalAssets;
        }
        _mint(msg.sender, shares);
    }
}

// ATTACK using flash loan:
// 1. Attacker deposits 1 wei, gets 1 share
// 2. Flash loan large amount
// 3. "Donate" (transfer directly) to vault
// 4. Victim deposits → gets 0 shares due to rounding
// 5. Attacker withdraws → gets victim's deposit too
// 6. Repay flash loan with profit

// SECURE - virtual offset
contract SecureVault {
    uint256 internal constant OFFSET = 10 ** 3;  // Virtual shares/assets
    
    function deposit(uint256 assets) external returns (uint256 shares) {
        shares = assets * (totalSupply + OFFSET) / (totalAssets + OFFSET);
        require(shares > 0, "Zero shares");
        _mint(msg.sender, shares);
    }
}
```

