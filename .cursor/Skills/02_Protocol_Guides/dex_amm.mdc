# 🔄 DEX/AMM Security Guide

## Core Components

1. **Liquidity Pools** - Token reserves and pricing
2. **Swaps** - Token exchanges
3. **Liquidity Provision** - Adding/removing liquidity
4. **Price Oracles** - TWAP and spot prices
5. **Fees** - Trading and protocol fees

---

## Critical Vulnerabilities

### 1. Price Manipulation

```solidity
// VULNERABLE - using spot price
function getPrice() public view returns (uint256) {
    return reserve0 * 1e18 / reserve1;  // Manipulable in single tx
}

// SECURE - use TWAP
function getPrice() public view returns (uint256) {
    uint256 timeElapsed = block.timestamp - lastObservation;
    require(timeElapsed >= MIN_TWAP_PERIOD, "TWAP too short");
    return (priceCumulativeLast - priceCumulativeOld) / timeElapsed;
}
```

### 2. Sandwich Attacks

```solidity
// VULNERABLE - no slippage protection
function swap(uint256 amountIn) external {
    uint256 amountOut = getAmountOut(amountIn);
    // Attacker front-runs with buy, user gets worse rate
    token.transfer(msg.sender, amountOut);
}

// SECURE - require minimum output
function swap(uint256 amountIn, uint256 minAmountOut, uint256 deadline) external {
    require(block.timestamp <= deadline, "Expired");
    uint256 amountOut = getAmountOut(amountIn);
    require(amountOut >= minAmountOut, "Slippage");
    token.transfer(msg.sender, amountOut);
}
```

### 3. First Liquidity Provider Attack

```solidity
// VULNERABLE - LP can set arbitrary initial price
function addLiquidity(uint256 amount0, uint256 amount1) external {
    if (totalSupply == 0) {
        liquidity = sqrt(amount0 * amount1);  // Any ratio accepted
    }
}

// SECURE - require price within expected bounds
function addLiquidity(uint256 amount0, uint256 amount1) external {
    if (totalSupply == 0) {
        uint256 price = amount0 * 1e18 / amount1;
        require(price >= minInitialPrice && price <= maxInitialPrice);
        liquidity = sqrt(amount0 * amount1);
        // Also: mint dead shares to prevent donation attacks
        _mint(address(0), MINIMUM_LIQUIDITY);
    }
}
```

### 4. Reentrancy on Remove Liquidity

```solidity
// VULNERABLE - burns LP before transfer
function removeLiquidity(uint256 liquidity) external {
    uint256 amount0 = liquidity * reserve0 / totalSupply;
    uint256 amount1 = liquidity * reserve1 / totalSupply;
    
    _burn(msg.sender, liquidity);
    
    token0.transfer(msg.sender, amount0);  // Callback here
    token1.transfer(msg.sender, amount1);
    
    _update();  // Stale reserves during callback
}

// SECURE - CEI pattern + reentrancy guard
function removeLiquidity(uint256 liquidity) external nonReentrant {
    uint256 amount0 = liquidity * reserve0 / totalSupply;
    uint256 amount1 = liquidity * reserve1 / totalSupply;
    
    _burn(msg.sender, liquidity);
    _update(reserve0 - amount0, reserve1 - amount1);  // Update BEFORE
    
    token0.transfer(msg.sender, amount0);
    token1.transfer(msg.sender, amount1);
}
```

### 5. K Value Manipulation

```solidity
// VULNERABLE - K not verified after swap
function swap(uint256 amount0Out, uint256 amount1Out) external {
    require(amount0Out > 0 || amount1Out > 0);
    
    token0.transfer(msg.sender, amount0Out);
    token1.transfer(msg.sender, amount1Out);
    
    // Missing K invariant check!
}

// SECURE - verify K maintained
function swap(uint256 amount0Out, uint256 amount1Out) external {
    uint256 balance0After = token0.balanceOf(address(this));
    uint256 balance1After = token1.balanceOf(address(this));
    
    // Verify K invariant (with fee adjustment)
    uint256 balance0Adjusted = balance0After * 1000 - amount0In * 3;
    uint256 balance1Adjusted = balance1After * 1000 - amount1In * 3;
    
    require(balance0Adjusted * balance1Adjusted >= reserve0 * reserve1 * 1000000);
}
```

