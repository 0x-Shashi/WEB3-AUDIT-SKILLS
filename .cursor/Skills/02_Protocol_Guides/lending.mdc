## Compound/Aave Specific Patterns

### cToken Exchange Rate

```solidity
// Exchange rate can be manipulated by donation
// First depositor attack:
// 1. Deposit 1 wei
// 2. Donate large amount directly
// 3. Exchange rate inflated
// 4. Victim deposits, gets 0 cTokens

// SECURE - virtual shares
function exchangeRate() public view returns (uint256) {
    uint256 totalCash = getCash();
    uint256 totalBorrows = totalBorrows;
    uint256 totalSupply = totalSupply;
    
    if (totalSupply == 0) {
        return initialExchangeRate;
    }
    
    // Use virtual reserves
    return (totalCash + totalBorrows + VIRTUAL_OFFSET) * 1e18 / (totalSupply + VIRTUAL_OFFSET);
}
```

### Flash Loan Integration

```solidity
// Lending protocols often provide flash loans
// Ensure borrowing doesn't affect lending health factor in same tx

function flashLoan(uint256 amount, bytes calldata data) external {
    uint256 balanceBefore = token.balanceOf(address(this));
    
    token.transfer(msg.sender, amount);
    IFlashBorrower(msg.sender).onFlashLoan(amount, data);
    
    uint256 balanceAfter = token.balanceOf(address(this));
    require(balanceAfter >= balanceBefore + flashFee, "Not repaid");
    
    // Don't allow flash loan to affect borrow positions
    require(getHealthFactor(msg.sender) >= 1e18, "Unhealthy after flash");
}
```

