## 5. Solidity Quirks

### Default Values

```solidity
// Uninitialized variables have default values
uint256 x;        // 0
bool flag;        // false
address addr;     // address(0)
bytes32 hash;     // 0x0000...

// VULNERABLE - checking "set" by value
function isSet() view returns (bool) {
    return value != 0;  // 0 could be valid!
}

// SECURE - explicit flag
mapping(bytes32 => bool) public isValueSet;
```

### delete Behavior

```solidity
// delete resets to default
uint256[] arr = [1, 2, 3];
delete arr[1];    // arr = [1, 0, 3] - NOT removed!

// To remove from array, swap and pop
function remove(uint256 index) external {
    arr[index] = arr[arr.length - 1];
    arr.pop();
}
```

### Struct Assignment

```solidity
// VULNERABLE - reference vs copy
function modifyStruct() external {
    Struct storage s = structs[id];  // Reference
    s.value = 123;  // Modifies storage
    
    Struct memory m = structs[id];   // Copy
    m.value = 456;  // Only modifies memory copy!
}
```

