# ⚙️ EVM Security Patterns

## 1. Storage Layout

### Slot Calculation

```solidity
// Basic types in order of declaration
contract Storage {
    uint256 a;      // slot 0
    uint256 b;      // slot 1
    uint128 c;      // slot 2 (lower 128 bits)
    uint128 d;      // slot 2 (upper 128 bits) - packed!
    uint256 e;      // slot 3
}

// Mappings
mapping(address => uint256) balances;
// balances[addr] is at: keccak256(abi.encode(addr, slot))

// Dynamic arrays
uint256[] amounts;
// amounts.length is at: slot
// amounts[i] is at: keccak256(abi.encode(slot)) + i

// Nested mappings
mapping(address => mapping(address => uint256)) allowances;
// allowances[a][b] is at: keccak256(abi.encode(b, keccak256(abi.encode(a, slot))))
```

### Storage Collision (Upgradeable)

```solidity
// VULNERABLE - different storage layouts
// Implementation V1
contract V1 {
    address owner;      // slot 0
    uint256 value;      // slot 1
}

// Implementation V2 - WRONG ORDER!
contract V2 {
    uint256 value;      // slot 0 - OVERWRITES owner!
    address owner;      // slot 1
}

// SECURE - append only, use gaps
contract V1 {
    address owner;
    uint256 value;
    uint256[48] __gap;  // Reserve space
}

contract V2 is V1 {
    uint256 newValue;   // Uses gap space
    uint256[47] __gap;  // Reduced gap
}
```

