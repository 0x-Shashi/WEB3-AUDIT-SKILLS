## 3. Assembly Pitfalls

### Unchecked Return Data

```solidity
// VULNERABLE - doesn't check return data size
function unsafeCall(address target, bytes memory data) external {
    assembly {
        let success := call(gas(), target, 0, add(data, 32), mload(data), 0, 0)
        // returndata might be empty for contracts without return!
    }
}

// SECURE - validate return
function safeCall(address target, bytes memory data) external returns (bytes memory) {
    assembly {
        let success := call(gas(), target, 0, add(data, 32), mload(data), 0, 0)
        if iszero(success) {
            revert(0, returndatasize())
        }
        // Copy return data
        let size := returndatasize()
        let ptr := mload(0x40)
        returndatacopy(ptr, 0, size)
        return(ptr, size)
    }
}
```

### Memory Safety

```solidity
// VULNERABLE - corrupting free memory pointer
function corrupt() external {
    assembly {
        mstore(0x40, 0)  // Reset free memory pointer - BAD!
    }
}

// Memory layout:
// 0x00-0x3f: Scratch space (temporary)
// 0x40-0x5f: Free memory pointer
// 0x60-0x7f: Zero slot
// 0x80+:     Free memory

// SECURE - respect memory layout
function safe() external {
    assembly {
        let ptr := mload(0x40)
        // ... use ptr ...
        mstore(0x40, add(ptr, size))  // Update pointer correctly
    }
}
```

