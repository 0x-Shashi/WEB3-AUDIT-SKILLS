## Security Testing Patterns

### Reentrancy Test
```solidity
contract ReentrancyTest is Test {
    function test_reentrancy() public {
        Attacker attacker = new Attacker(address(target));
        vm.deal(address(attacker), 1 ether);
        
        // Fund target
        vm.deal(address(target), 10 ether);
        
        uint256 before = address(attacker).balance;
        attacker.attack();
        uint256 after = address(attacker).balance;
        
        // If attacker gained more than deposited, reentrancy exists
        assertLe(after - before, 1 ether, "Reentrancy vulnerability!");
    }
}
```

### Flash Loan Simulation
```solidity
function test_flashLoanAttack() public {
    // Simulate flash loan by dealing tokens
    uint256 loanAmount = 1_000_000 ether;
    deal(address(token), address(this), loanAmount);
    
    // Execute attack
    uint256 before = token.balanceOf(address(this));
    
    // ... attack steps ...
    
    // "Repay" flash loan
    token.transfer(address(0xdead), loanAmount);
    
    uint256 profit = token.balanceOf(address(this)) - before + loanAmount;
    assertEq(profit, 0, "Flash loan attack possible!");
}
```

