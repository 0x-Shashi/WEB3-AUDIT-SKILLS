## Invariant Testing

```solidity
// invariant/InvariantTest.t.sol
contract InvariantTest is Test {
    MyContract public target;
    Handler public handler;
    
    function setUp() public {
        target = new MyContract();
        handler = new Handler(target);
        
        // Target the handler contract
        targetContract(address(handler));
    }
    
    // This invariant is checked after every random call sequence
    function invariant_totalBalance() public {
        assertGe(
            address(target).balance,
            target.totalDeposited()
        );
    }
    
    function invariant_noNegativeBalances() public {
        address[] memory users = handler.getUsers();
        for (uint i = 0; i < users.length; i++) {
            assertGe(target.balances(users[i]), 0);
        }
    }
}

// Handler constrains random inputs to valid operations
contract Handler is Test {
    MyContract public target;
    address[] public users;
    
    constructor(MyContract _target) {
        target = _target;
        // Create test actors
        for (uint i = 0; i < 5; i++) {
            users.push(makeAddr(string(abi.encodePacked("user", i))));
            vm.deal(users[i], 100 ether);
        }
    }
    
    function deposit(uint256 userIndex, uint256 amount) public {
        userIndex = bound(userIndex, 0, users.length - 1);
        amount = bound(amount, 0, users[userIndex].balance);
        
        vm.prank(users[userIndex]);
        target.deposit{value: amount}();
    }
    
    function withdraw(uint256 userIndex, uint256 amount) public {
        userIndex = bound(userIndex, 0, users.length - 1);
        uint256 balance = target.balances(users[userIndex]);
        amount = bound(amount, 0, balance);
        
        vm.prank(users[userIndex]);
        target.withdraw(amount);
    }
    
    function getUsers() external view returns (address[] memory) {
        return users;
    }
}
```

