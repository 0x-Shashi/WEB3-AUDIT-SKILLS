# ⛽ Gas Optimization Patterns

## Storage Optimizations

### 1. Pack Storage Variables
```solidity
// EXPENSIVE - 3 slots (96 bytes)
contract Bad {
    uint256 a;      // slot 0
    uint8 b;        // slot 1
    uint256 c;      // slot 2
}

// OPTIMIZED - 2 slots (64 bytes)
contract Good {
    uint256 a;      // slot 0
    uint256 c;      // slot 1
    uint8 b;        // packed into slot 1 remainder
}
```

### 2. Use Mappings Over Arrays for Lookups
```solidity
// EXPENSIVE - O(n) lookup
address[] public users;
function exists(address user) public view returns (bool) {
    for (uint i = 0; i < users.length; i++) {
        if (users[i] == user) return true;
    }
    return false;
}

// OPTIMIZED - O(1) lookup
mapping(address => bool) public isUser;
function exists(address user) public view returns (bool) {
    return isUser[user];
}
```

### 3. Cache Storage in Memory
```solidity
// EXPENSIVE - multiple SLOADs
function bad() external {
    for (uint i = 0; i < array.length; i++) {  // SLOAD each iteration
        total += array[i];
    }
}

// OPTIMIZED - single SLOAD
function good() external {
    uint256 len = array.length;  // Cache length
    for (uint i = 0; i < len; i++) {
        total += array[i];
    }
}
```

### 4. Use Immutable for Deploy-Time Constants
```solidity
// EXPENSIVE - storage read
address public owner;
constructor(address _owner) { owner = _owner; }

// OPTIMIZED - embedded in bytecode
address public immutable owner;
constructor(address _owner) { owner = _owner; }
```

