## 8. Token Decimal Mismatches

```solidity
// VULNERABLE - assumes 18 decimals
function getUsdValue(uint256 tokenAmount, uint256 tokenPrice) external pure returns (uint256) {
    return (tokenAmount * tokenPrice) / 1e18;
}

// SECURE - handle different decimals
function getUsdValue(
    uint256 tokenAmount, 
    uint8 tokenDecimals,
    uint256 tokenPrice,
    uint8 priceDecimals
) external pure returns (uint256) {
    // Normalize to 18 decimals
    uint256 normalized = tokenAmount * tokenPrice;
    uint8 combinedDecimals = tokenDecimals + priceDecimals;
    
    if (combinedDecimals > 18) {
        return normalized / (10 ** (combinedDecimals - 18));
    } else {
        return normalized * (10 ** (18 - combinedDecimals));
    }
}
```

