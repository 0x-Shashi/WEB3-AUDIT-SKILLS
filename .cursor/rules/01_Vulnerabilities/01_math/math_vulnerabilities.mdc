## 9. Accumulator Overflow

```solidity
// VULNERABLE - accumulator can overflow over time
contract Staking {
    uint256 public rewardPerTokenStored;  // Accumulates continuously
    
    function updateReward() internal {
        // Can overflow if running for years with high rewards
        rewardPerTokenStored += (reward * 1e18) / totalSupply;
    }
}

// SECURE - use uint256 generously, monitor for realistic bounds
// Or implement periodic resets with proper accounting
```

