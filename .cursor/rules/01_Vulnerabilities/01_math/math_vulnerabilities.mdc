## 6. Phantom Overflow (Assembly)

```solidity
// In assembly, no overflow protection
function assemblyAdd(uint256 a, uint256 b) external pure returns (uint256 result) {
    assembly {
        result := add(a, b)  // Silently overflows!
    }
}

// SECURE - manual check
function safeAssemblyAdd(uint256 a, uint256 b) external pure returns (uint256 result) {
    assembly {
        result := add(a, b)
        if lt(result, a) { revert(0, 0) }  // Check for overflow
    }
}
```

