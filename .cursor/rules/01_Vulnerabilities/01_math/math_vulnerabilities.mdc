## 5. Division by Zero

```solidity
// VULNERABLE
function getPrice(uint256 reserve0, uint256 reserve1) external pure returns (uint256) {
    return reserve0 / reserve1;  // Reverts if reserve1 == 0
}

// SECURE
function getPrice(uint256 reserve0, uint256 reserve1) external pure returns (uint256) {
    require(reserve1 > 0, "Zero reserves");
    return reserve0 / reserve1;
}
```

