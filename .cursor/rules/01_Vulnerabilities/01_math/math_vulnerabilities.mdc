## 3. Rounding Direction Attacks

### Share Price Manipulation (First Depositor Attack)

```solidity
// VULNERABLE vault
contract VulnerableVault {
    function deposit(uint256 assets) external returns (uint256 shares) {
        if (totalSupply == 0) {
            shares = assets;
        } else {
            // Attacker: deposit 1 wei, donate massive amount
            // Next depositor gets 0 shares due to rounding
            shares = (assets * totalSupply) / totalAssets();
        }
        _mint(msg.sender, shares);
    }
}

// ATTACK:
// 1. Attacker deposits 1 wei → gets 1 share
// 2. Attacker donates 10 ETH directly to vault
// 3. totalAssets = 10 ETH + 1 wei, totalShares = 1
// 4. Victim deposits 5 ETH → gets (5e18 * 1) / 10e18 = 0 shares!

// SECURE: Virtual shares offset
contract SecureVault {
    uint256 constant OFFSET = 1e3;
    
    function deposit(uint256 assets) external returns (uint256 shares) {
        shares = (assets * (totalSupply + OFFSET)) / (totalAssets() + OFFSET);
        require(shares > 0, "Zero shares");
        _mint(msg.sender, shares);
    }
}
```

### Favor Protocol in Rounding

```solidity
// Rule: Round in favor of the protocol to prevent exploitation

// Deposits: Round DOWN shares (user gets less)
shares = (assets * totalShares) / totalAssets;  // Rounds down

// Withdrawals: Round DOWN assets (user gets less)
assets = (shares * totalAssets) / totalShares;  // Rounds down

// For ceiling division (when protocol should round up):
function divCeil(uint256 a, uint256 b) pure returns (uint256) {
    return (a + b - 1) / b;
}
```

