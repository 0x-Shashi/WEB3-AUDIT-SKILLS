## 4. Unsafe Type Casting

### Signed/Unsigned Conversion

```solidity
// VULNERABLE
function dangerous(int256 signedValue) external pure returns (uint256) {
    return uint256(signedValue);  // -1 becomes 2^256 - 1!
}

// SECURE
function safe(int256 signedValue) external pure returns (uint256) {
    require(signedValue >= 0, "Negative value");
    return uint256(signedValue);
}
```

### Downcasting

```solidity
// VULNERABLE
uint256 big = 300;
uint8 small = uint8(big);  // Truncates to 44 (300 % 256)

// SECURE - use SafeCast
import "@openzeppelin/contracts/utils/math/SafeCast.sol";
uint8 small = SafeCast.toUint8(big);  // Reverts if > 255
```

