## 7. Percentage/Basis Point Errors

```solidity
// Common mistake: confusing percentage vs basis points
uint256 constant PERCENTAGE_BASE = 100;        // 1% = 1
uint256 constant BASIS_POINTS_BASE = 10000;    // 1% = 100

// VULNERABLE - wrong base
function calculateFee(uint256 amount, uint256 feePercent) external pure returns (uint256) {
    return (amount * feePercent) / 100;  // If feePercent is meant to be bps, this is 100x off!
}

// SECURE - clear naming and consistent usage
uint256 public feeBps = 30;  // 0.3% = 30 bps

function calculateFee(uint256 amount) external view returns (uint256) {
    return (amount * feeBps) / BASIS_POINTS_BASE;
}
```

