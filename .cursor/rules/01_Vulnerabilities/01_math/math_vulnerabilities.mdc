## 10. Multiplication Overflow Before Division

```solidity
// VULNERABLE - intermediate overflow
function calculate(uint256 a, uint256 b, uint256 c) external pure returns (uint256) {
    return (a * b) / c;  // a * b might overflow before dividing
}

// SECURE - use mulDiv for large numbers
import "@openzeppelin/contracts/utils/math/Math.sol";

function calculate(uint256 a, uint256 b, uint256 c) external pure returns (uint256) {
    return Math.mulDiv(a, b, c);  // Handles overflow correctly
}
```

