## 10. Time-Lock Bypass

```solidity
// VULNERABLE - emergency bypass defeats timelock
contract Vulnerable {
    uint256 public constant TIMELOCK = 2 days;
    
    function scheduleAction(bytes32 actionId) external onlyOwner {
        scheduledTime[actionId] = block.timestamp + TIMELOCK;
    }
    
    function executeAction(bytes32 actionId) external onlyOwner {
        require(block.timestamp >= scheduledTime[actionId]);
        _execute(actionId);
    }
    
    // Defeats the purpose of timelock!
    function emergencyExecute(bytes32 actionId) external onlyOwner {
        _execute(actionId);
    }
}

// SECURE - no bypasses, or emergency requires multisig
contract Secure {
    uint256 public constant TIMELOCK = 2 days;
    address public guardian;  // Multisig for emergencies
    
    function emergencyExecute(bytes32 actionId) external {
        require(msg.sender == guardian, "Only guardian");
        // Guardian should be high-threshold multisig
        _execute(actionId);
    }
}
```

