## 4. Privilege Escalation

### Role Inheritance Issues

```solidity
// VULNERABLE - operator can become admin
contract Vulnerable {
    mapping(address => bool) public isOperator;
    mapping(address => bool) public isAdmin;
    
    function setOperator(address user, bool status) external {
        require(isOperator[msg.sender], "Not operator");
        isOperator[user] = status;  // Operators can add other operators
    }
    
    // If there's any path where operator can set isAdmin...
}

// SECURE - strict role hierarchy
contract Secure is AccessControl {
    bytes32 constant ADMIN = keccak256("ADMIN");
    bytes32 constant OPERATOR = keccak256("OPERATOR");
    
    function setOperator(address user, bool status) external onlyRole(ADMIN) {
        // Only admins can modify operator roles
        if (status) {
            grantRole(OPERATOR, user);
        } else {
            revokeRole(OPERATOR, user);
        }
    }
}
```

