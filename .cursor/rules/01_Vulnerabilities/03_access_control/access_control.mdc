## 9. Two-Step Ownership Transfer

```solidity
// RISKY - single step transfer
contract Risky {
    address public owner;
    
    function transferOwnership(address newOwner) external {
        require(msg.sender == owner);
        owner = newOwner;  // Typo = lost forever
    }
}

// SECURE - two step with acceptance
import "@openzeppelin/contracts/access/Ownable2Step.sol";

contract Secure is Ownable2Step {
    // transferOwnership() sets pendingOwner
    // acceptOwnership() must be called by new owner
}

// Manual implementation
contract SecureManual {
    address public owner;
    address public pendingOwner;
    
    function transferOwnership(address newOwner) external {
        require(msg.sender == owner);
        pendingOwner = newOwner;
    }
    
    function acceptOwnership() external {
        require(msg.sender == pendingOwner);
        owner = pendingOwner;
        pendingOwner = address(0);
    }
}
```

