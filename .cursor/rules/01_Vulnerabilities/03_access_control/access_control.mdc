## 5. Signature-Based Access Control Issues

### Missing Signer Validation

```solidity
// VULNERABLE - doesn't verify signer is authorized
contract Vulnerable {
    function execute(bytes calldata data, bytes calldata signature) external {
        address signer = recoverSigner(data, signature);
        // Execute without checking if signer is authorized!
        _execute(data);
    }
}

// SECURE
contract Secure {
    mapping(address => bool) public authorizedSigners;
    
    function execute(bytes calldata data, bytes calldata signature) external {
        address signer = recoverSigner(data, signature);
        require(authorizedSigners[signer], "Unauthorized signer");
        _execute(data);
    }
}
```

### Signature Replay

```solidity
// VULNERABLE - no nonce/expiry
contract Vulnerable {
    function executeWithSig(
        address to,
        uint256 amount,
        bytes calldata signature
    ) external {
        bytes32 hash = keccak256(abi.encodePacked(to, amount));
        address signer = ECDSA.recover(hash, signature);
        require(signer == owner, "Invalid signature");
        _transfer(to, amount);  // Can replay same signature!
    }
}

// SECURE - include nonce and chain ID
contract Secure {
    mapping(address => uint256) public nonces;
    
    function executeWithSig(
        address to,
        uint256 amount,
        uint256 deadline,
        bytes calldata signature
    ) external {
        require(block.timestamp <= deadline, "Expired");
        
        bytes32 hash = keccak256(abi.encodePacked(
            to, 
            amount, 
            nonces[owner]++,  // Increment nonce
            block.chainid,    // Chain ID for cross-chain protection
            deadline
        ));
        
        address signer = ECDSA.recover(hash.toEthSignedMessageHash(), signature);
        require(signer == owner, "Invalid signature");
        _transfer(to, amount);
    }
}
```

