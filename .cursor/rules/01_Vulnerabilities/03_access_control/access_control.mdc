## 3. Incorrect Modifier Logic

```solidity
// VULNERABLE - modifier doesn't protect
contract Vulnerable {
    address public owner;
    
    modifier onlyOwner() {
        if (msg.sender == owner) {
            _;
        }
        // Missing revert for non-owners - function still executes!
    }
}

// SECURE
modifier onlyOwner() {
    require(msg.sender == owner, "Not owner");
    _;
}

// ALSO SECURE
modifier onlyOwner() {
    if (msg.sender != owner) revert NotOwner();
    _;
}
```

