## 3. Oracle Decimal Mismatch

```solidity
// VULNERABLE - assumes all oracles have same decimals
contract Vulnerable {
    function getValue(uint256 tokenAmount, int256 price) public pure returns (uint256) {
        // ETH/USD is 8 decimals, some are 18
        return tokenAmount * uint256(price) / 1e18;  // WRONG if price is 8 decimals
    }
}

// SECURE - always check decimals
contract Secure {
    function getValue(
        uint256 tokenAmount,
        uint8 tokenDecimals,
        AggregatorV3Interface oracle
    ) public view returns (uint256) {
        (, int256 price,,,) = oracle.latestRoundData();
        uint8 priceDecimals = oracle.decimals();
        
        // Normalize to 18 decimals
        uint256 normalizedPrice = uint256(price) * 10**(18 - priceDecimals);
        uint256 normalizedAmount = tokenAmount * 10**(18 - tokenDecimals);
        
        return normalizedAmount * normalizedPrice / 1e18;
    }
}
```

