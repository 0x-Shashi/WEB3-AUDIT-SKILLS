## 5. Oracle DoS / Unavailability

```solidity
// VULNERABLE - reverts if oracle fails
contract Vulnerable {
    function getPrice() public view returns (uint256) {
        (, int256 price,,,) = oracle.latestRoundData();  // Reverts on failure
        return uint256(price);
    }
}

// SECURE - fallback oracles
contract Secure {
    AggregatorV3Interface public primaryOracle;
    AggregatorV3Interface public fallbackOracle;
    
    function getPrice() public view returns (uint256) {
        try primaryOracle.latestRoundData() returns (
            uint80, int256 price, uint256, uint256 updatedAt, uint80
        ) {
            if (price > 0 && block.timestamp - updatedAt < 1 hours) {
                return uint256(price);
            }
        } catch {}
        
        // Fallback to secondary oracle
        (, int256 fallbackPrice,,,) = fallbackOracle.latestRoundData();
        require(fallbackPrice > 0, "All oracles failed");
        return uint256(fallbackPrice);
    }
}
```

