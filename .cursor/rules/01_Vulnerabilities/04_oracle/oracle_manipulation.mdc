## 6. LP Token Price Manipulation

```solidity
// VULNERABLE - LP token price from reserves
function getLPValue(uint256 lpAmount) public view returns (uint256) {
    uint256 totalSupply = lpToken.totalSupply();
    (uint256 reserve0, uint256 reserve1) = pool.getReserves();
    
    // Attacker can flash loan to inflate reserves
    uint256 lpShare = lpAmount * 1e18 / totalSupply;
    uint256 value0 = reserve0 * lpShare / 1e18 * price0;
    uint256 value1 = reserve1 * lpShare / 1e18 * price1;
    
    return value0 + value1;  // Manipulable!
}

// SECURE - use fair LP pricing (Alpha Homora method)
function getFairLPValue(uint256 lpAmount) public view returns (uint256) {
    uint256 totalSupply = lpToken.totalSupply();
    (uint256 reserve0, uint256 reserve1) = pool.getReserves();
    
    // Fair reserve based on external prices
    uint256 sqrtK = sqrt(reserve0 * reserve1);
    uint256 sqrtP = sqrt(price0 * price1);
    
    // Fair value resistant to reserve manipulation
    uint256 fairValue = 2 * sqrtK * sqrtP / totalSupply;
    return fairValue * lpAmount;
}
```

