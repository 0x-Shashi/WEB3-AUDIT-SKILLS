## 10. Cross-Chain Oracle Issues

```solidity
// VULNERABLE - no sequencer uptime check on L2
contract VulnerableL2 {
    function getPrice() public view returns (uint256) {
        (, int256 price,,,) = oracle.latestRoundData();
        return uint256(price);  // Stale if sequencer was down!
    }
}

// SECURE - check L2 sequencer uptime (Arbitrum/Optimism)
contract SecureL2 {
    AggregatorV3Interface public sequencerUptimeFeed;
    uint256 public constant GRACE_PERIOD = 1 hours;
    
    function getPrice() public view returns (uint256) {
        // Check sequencer is up
        (, int256 answer, uint256 startedAt,,) = sequencerUptimeFeed.latestRoundData();
        
        bool isSequencerUp = answer == 0;
        require(isSequencerUp, "Sequencer down");
        
        uint256 timeSinceUp = block.timestamp - startedAt;
        require(timeSinceUp > GRACE_PERIOD, "Grace period not passed");
        
        // Now safe to use price oracle
        (, int256 price,,,) = priceOracle.latestRoundData();
        return uint256(price);
    }
}
```

