## 7. Curve Virtual Price Manipulation

```solidity
// VULNERABLE - using virtual_price during reentrancy
contract Vulnerable {
    ICurvePool public curvePool;
    
    function getVaultValue() public view returns (uint256) {
        // During remove_liquidity callback, this returns STALE value
        uint256 virtualPrice = curvePool.get_virtual_price();
        return balance * virtualPrice / 1e18;
    }
}

// SECURE - check for reentrancy
contract Secure {
    function getVaultValue() public view returns (uint256) {
        // Try to detect if we're in a Curve callback
        // Some Curve pools expose locked() function
        if (address(curvePool).code.length > 0) {
            try ICurveWithLock(address(curvePool)).locked() returns (bool isLocked) {
                require(!isLocked, "Pool locked");
            } catch {}
        }
        
        uint256 virtualPrice = curvePool.get_virtual_price();
        return balance * virtualPrice / 1e18;
    }
}
```

