    uint32[] memory secondsAgos = new uint32[](2);
    secondsAgos[0] = 600;  // 10 minutes - too short!
    secondsAgos[1] = 0;
    
    (int56[] memory tickCumulatives,) = pool.observe(secondsAgos);
    // ... calculate TWAP
}

// SECURE - longer window, multiple sources
function getTWAP() external view returns (uint256) {
    uint32[] memory secondsAgos = new uint32[](2);
    secondsAgos[0] = 1800;  // 30 minutes minimum
    secondsAgos[1] = 0;
    
    // Also validate against Chainlink as backup
    uint256 twapPrice = calculateTWAP(...);
    uint256 chainlinkPrice = getChainlinkPrice();
    
    require(
        twapPrice > chainlinkPrice * 95 / 100 &&
        twapPrice < chainlinkPrice * 105 / 100,
        "Price deviation too high"
    );
    
    return twapPrice;
}
