## 8. Composable Oracle Risks

### Derived Asset Pricing

```solidity
// VULNERABLE - stETH priced as ETH
contract Vulnerable {
    function getstETHValue(uint256 amount) public view returns (uint256) {
        // Assumes stETH = ETH (it's not always!)
        return amount * getETHPrice();
    }
}

// SECURE - use stETH-specific oracle
contract Secure {
    AggregatorV3Interface public stETHOracle;  // stETH/ETH feed
    AggregatorV3Interface public ethOracle;    // ETH/USD feed
    
    function getstETHValue(uint256 amount) public view returns (uint256) {
        (, int256 stethRatio,,,) = stETHOracle.latestRoundData();  // stETH/ETH
        (, int256 ethPrice,,,) = ethOracle.latestRoundData();       // ETH/USD
        
        return amount * uint256(stethRatio) * uint256(ethPrice) / 1e26;
    }
}
```

