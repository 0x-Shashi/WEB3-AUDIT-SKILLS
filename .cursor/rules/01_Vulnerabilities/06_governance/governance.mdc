# 🏛️ Governance Vulnerabilities

## 1. Flash Loan Governance Attack

```solidity
// VULNERABLE - current balance for voting power
function getVotes(address account) public view returns (uint256) {
    return token.balanceOf(account);  // Flashloanable!
}

// SECURE - snapshot-based voting
function getVotes(address account, uint256 snapshotId) public view returns (uint256) {
    return token.balanceOfAt(account, snapshotId);
}
```

---

## 2. Proposal Frontrunning

```solidity
// VULNERABLE - can vote immediately
function propose(bytes calldata data) external returns (uint256) {
    proposals[proposalCount] = Proposal({
        startBlock: block.number,  // Starts immediately
        endBlock: block.number + VOTING_PERIOD
    });
}

// SECURE - voting delay
function propose(bytes calldata data) external returns (uint256) {
    proposals[proposalCount] = Proposal({
        startBlock: block.number + VOTING_DELAY,  // Delay before voting
        endBlock: block.number + VOTING_DELAY + VOTING_PERIOD
    });
}
```

---

## 3. Quorum Manipulation

```solidity
// VULNERABLE - quorum based on current supply
function quorum() public view returns (uint256) {
    return token.totalSupply() * 4 / 100;  // 4% of current supply
}
// If supply suddenly increases, past proposals become harder to pass

// SECURE - snapshot quorum
function quorum(uint256 proposalId) public view returns (uint256) {
    uint256 snapshot = proposals[proposalId].snapshot;
    return token.totalSupplyAt(snapshot) * 4 / 100;
}
```

---

## 4. Timelock Bypass

```solidity
// VULNERABLE - emergency execution without timelock
function emergencyExecute(bytes calldata data) external onlyGuardian {
    Address.functionCall(target, data);  // Bypasses timelock!
}

// SECURE - guardian can only cancel, not execute
function cancelProposal(uint256 proposalId) external onlyGuardian {
    proposals[proposalId].cancelled = true;
}
```

