## 6. Voting Threshold Manipulation

```solidity
// VULNERABLE - proposal threshold can be changed mid-vote
function setProposalThreshold(uint256 newThreshold) external onlyAdmin {
    proposalThreshold = newThreshold;  // Affects existing proposals
}

// SECURE - threshold locked at proposal creation
struct Proposal {
    uint256 threshold;  // Stored at creation
}
```

---

## 7. Double Voting

```solidity
// VULNERABLE - no vote tracking
function vote(uint256 proposalId, bool support) external {
    uint256 votes = getVotes(msg.sender);
    if (support) {
        proposals[proposalId].forVotes += votes;
    }
    // Can vote multiple times!
}

// SECURE - track voters
mapping(uint256 => mapping(address => bool)) public hasVoted;

function vote(uint256 proposalId, bool support) external {
    require(!hasVoted[proposalId][msg.sender], "Already voted");
    hasVoted[proposalId][msg.sender] = true;
    // ...
}
```

---

## 8. Griefing via Spam Proposals

```solidity
// VULNERABLE - no proposal cost
function propose(bytes calldata data) external returns (uint256) {
    // Anyone can create proposals
}

// SECURE - require minimum token threshold
function propose(bytes calldata data) external returns (uint256) {
    require(getVotes(msg.sender) >= proposalThreshold);
    // Or require stake that's slashed if proposal fails badly
}
```

