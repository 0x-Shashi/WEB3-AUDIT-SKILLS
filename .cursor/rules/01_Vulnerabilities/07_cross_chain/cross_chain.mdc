## 6. Bridge Liquidity Issues

```solidity
// VULNERABLE - bridge can be drained
function withdraw(uint256 amount, bytes calldata proof) external {
    require(verifyProof(proof, msg.sender, amount), "Invalid proof");
    token.transfer(msg.sender, amount);
    // What if bridge doesn't have enough liquidity?
}

// SECURE - check liquidity, implement rate limiting
mapping(uint256 => uint256) public dailyWithdrawals;
uint256 public maxDailyWithdrawal;

function withdraw(uint256 amount, bytes calldata proof) external {
    require(verifyProof(proof, msg.sender, amount), "Invalid proof");
    
    uint256 today = block.timestamp / 1 days;
    require(dailyWithdrawals[today] + amount <= maxDailyWithdrawal, "Rate limited");
    dailyWithdrawals[today] += amount;
    
    require(token.balanceOf(address(this)) >= amount, "Insufficient liquidity");
    token.transfer(msg.sender, amount);
}
```

