## 2. Chain ID Not Validated

```solidity
// VULNERABLE - accepts messages for any chain
function processMessage(bytes calldata message) external {
    (address recipient, uint256 amount) = abi.decode(message, (address, uint256));
    token.transfer(recipient, amount);
}

// SECURE - validate destination chain
function processMessage(bytes calldata message) external {
    (uint256 destChainId, address recipient, uint256 amount) = 
        abi.decode(message, (uint256, address, uint256));
    
    require(destChainId == block.chainid, "Wrong chain");
    token.transfer(recipient, amount);
}
```

