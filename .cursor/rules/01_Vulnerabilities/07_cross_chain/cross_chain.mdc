## 3. Relayer Signature Issues

```solidity
// VULNERABLE - single relayer can forge
function processMessage(bytes calldata message, bytes calldata sig) external {
    require(verify(message, sig, relayer), "Bad sig");
    _execute(message);
}

// SECURE - multisig threshold
function processMessage(bytes calldata message, bytes[] calldata sigs) external {
    uint256 validSigs = 0;
    address[] memory signers = new address[](sigs.length);
    
    for (uint i = 0; i < sigs.length; i++) {
        address signer = recoverSigner(message, sigs[i]);
        require(isRelayer[signer], "Not relayer");
        
        // Check for duplicate signers
        for (uint j = 0; j < i; j++) {
            require(signers[j] != signer, "Duplicate");
        }
        signers[i] = signer;
        validSigs++;
    }
    
    require(validSigs >= threshold, "Not enough sigs");
    _execute(message);
}
```

