## 4. Griefing via Revert

```solidity
// VULNERABLE - malicious receiver can block
function airdrop(address[] calldata recipients, uint256 amount) external {
    for (uint i = 0; i < recipients.length; i++) {
        token.transfer(recipients[i], amount);  // Malicious contract reverts
    }
}

// SECURE - try/catch or skip failures
function airdrop(address[] calldata recipients, uint256 amount) external {
    for (uint i = 0; i < recipients.length; i++) {
        try token.transfer(recipients[i], amount) {} catch {
            // Log failure, continue
            emit TransferFailed(recipients[i], amount);
        }
    }
}
```

