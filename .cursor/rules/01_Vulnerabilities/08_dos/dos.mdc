// Attacker sees tx in mempool, frontruns with higher gas

// SECURE - commit-reveal or signature
mapping(bytes32 => bool) public committed;

function commit(bytes32 hash) external {
    committed[hash] = true;
}

function reveal(bytes32 secret) external {
    bytes32 hash = keccak256(abi.encodePacked(msg.sender, secret));
    require(committed[hash], "Not committed");
