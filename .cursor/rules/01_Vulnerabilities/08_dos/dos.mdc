## 3. Block Gas Limit DoS

```solidity
// VULNERABLE - state grows unbounded
function addMember(address member) external {
    members.push(member);  // Array grows forever
}

function calculateVotes() external view returns (uint256) {
    uint256 total = 0;
    for (uint i = 0; i < members.length; i++) {  // Eventually too expensive
        total += balances[members[i]];
    }
    return total;
}

// SECURE - use mapping with counter or merkle tree
uint256 public totalVotes;

function updateVotes(uint256 previousBalance, uint256 newBalance) internal {
    totalVotes = totalVotes - previousBalance + newBalance;
}
```

