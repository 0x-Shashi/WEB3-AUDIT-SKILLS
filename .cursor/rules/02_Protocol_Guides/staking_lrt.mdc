# 🔒 Staking & Liquid Restaking Security

## Core Components

1. **Staking Contracts** - Lock tokens for rewards
2. **Liquid Staking** - Stake and receive liquid derivative
3. **Restaking** - Reuse staked assets for additional yield
4. **Rewards Distribution** - Calculate and claim rewards

---

## Critical Vulnerabilities

### 1. Reward Calculation Manipulation

```solidity
// VULNERABLE - rewards based on current stake
function claimRewards() external {
    uint256 rewards = (balances[msg.sender] * rewardRate * timeElapsed) / totalStaked;
    rewardToken.transfer(msg.sender, rewards);
}

// ATTACK:
// 1. Flash loan tokens
// 2. Stake (become 99% of pool)
// 3. Claim 99% of pending rewards
// 4. Unstake, repay flash loan

// SECURE - time-weighted staking
mapping(address => uint256) public stakedAt;
uint256 public constant MIN_STAKE_DURATION = 7 days;

function claimRewards() external {
    require(block.timestamp - stakedAt[msg.sender] >= MIN_STAKE_DURATION);
    uint256 rewards = calculateTimeWeightedRewards(msg.sender);
    rewardToken.transfer(msg.sender, rewards);
}
```

### 2. Exchange Rate Manipulation

```solidity
// VULNERABLE stETH-style contract
function getExchangeRate() public view returns (uint256) {
    return totalAssets() / totalShares;  // Manipulable by donation
}

// First depositor attack:
// 1. Deposit 1 wei → get 1 share
// 2. Donate 1000 ETH directly to contract
// 3. Exchange rate = 1000 ETH / 1 share
// 4. Next depositor with 500 ETH → 0 shares!

// SECURE - virtual shares
function getExchangeRate() public view returns (uint256) {
    return (totalAssets() + VIRTUAL_ASSETS) / (totalShares + VIRTUAL_SHARES);
}
```

### 3. Slashing Condition Bypass

```solidity
// VULNERABLE - slashing based on external oracle
function slash(address validator) external {
    require(oracle.isSlashable(validator), "Not slashable");
    _slash(validator);
}

// If oracle is compromised, innocent validators slashed

// SECURE - multiple conditions + timelock
function proposeSlash(address validator, bytes calldata evidence) external {
    require(verifyEvidence(evidence), "Invalid evidence");
    slashProposals[validator] = SlashProposal({
        timestamp: block.timestamp,
        evidence: evidence
    });
}

function executeSlash(address validator) external {
    SlashProposal memory proposal = slashProposals[validator];
    require(block.timestamp >= proposal.timestamp + SLASH_DELAY);
    require(!contestedSlash[validator]);
    _slash(validator);
}
```

### 4. Unbonding Period Issues

```solidity
// VULNERABLE - no unbonding period
function unstake(uint256 shares) external {
    uint256 assets = convertToAssets(shares);
    _burn(msg.sender, shares);
    underlying.transfer(msg.sender, assets);  // Immediate!
}

// User can unstake right before slashing event

// SECURE - unbonding queue
struct UnbondingRequest {
    uint256 shares;
    uint256 unbondingEnd;
}

function requestUnstake(uint256 shares) external {
    unbondingRequests[msg.sender].push(UnbondingRequest({
        shares: shares,
        unbondingEnd: block.timestamp + UNBONDING_PERIOD
    }));
    // Shares still subject to slashing during unbonding
}

function completeUnstake(uint256 requestId) external {
    UnbondingRequest memory request = unbondingRequests[msg.sender][requestId];
    require(block.timestamp >= request.unbondingEnd);
    uint256 assets = convertToAssets(request.shares);
    _burn(msg.sender, request.shares);
    underlying.transfer(msg.sender, assets);
}
```

### 5. Operator Mismanagement

```solidity
// LRT restaking vulnerabilities

// VULNERABLE - operator can steal by delegating to malicious AVS
function delegateToOperator(address operator) external onlyOwner {
    eigenLayer.delegateTo(operator);  // No validation of operator
}

// SECURE - whitelisted operators + limits
mapping(address => bool) public approvedOperators;
mapping(address => uint256) public operatorDelegation;
uint256 public maxDelegationPerOperator;

function delegateToOperator(address operator, uint256 amount) external onlyOwner {
    require(approvedOperators[operator], "Operator not approved");
    require(operatorDelegation[operator] + amount <= maxDelegationPerOperator);
    operatorDelegation[operator] += amount;
    eigenLayer.delegateTo(operator, amount);
}
```

### 6. Withdrawal Delay Griefing

```solidity
// VULNERABLE - attacker can grief withdrawals
function withdraw(uint256 shares) external {
    require(pendingWithdrawals + shares <= availableLiquidity);
    pendingWithdrawals += shares;
    // ... process withdrawal
}

// Attacker: create many small withdrawals, block legitimate users

// SECURE - per-user withdrawal limits + queue
mapping(address => uint256) public lastWithdrawal;
uint256 public withdrawalCooldown = 1 hours;

function withdraw(uint256 shares) external {
    require(block.timestamp >= lastWithdrawal[msg.sender] + withdrawalCooldown);
    lastWithdrawal[msg.sender] = block.timestamp;
    // ... process
}
```

### 7. Rebasing Token Integration

```solidity
// VULNERABLE - wrapping rebasing tokens incorrectly
function wrap(uint256 amount) external {
    stETH.transferFrom(msg.sender, address(this), amount);
    _mint(msg.sender, amount);  // Wrong! stETH balance changes
}

// SECURE - track shares, not amount
function wrap(uint256 stETHAmount) external {
    uint256 sharesBefore = stETH.sharesOf(address(this));
    stETH.transferFrom(msg.sender, address(this), stETHAmount);
    uint256 sharesReceived = stETH.sharesOf(address(this)) - sharesBefore;
    _mint(msg.sender, sharesReceived);  // Mint based on shares
}
```

### 8. Validator Registry Attacks

```solidity
// VULNERABLE - unlimited validator registration
function registerValidator(bytes calldata pubkey) external {
    validators.push(Validator({pubkey: pubkey, owner: msg.sender}));
}

// Attacker registers thousands of fake validators

// SECURE - stake requirement + verification
function registerValidator(
    bytes calldata pubkey, 
    bytes calldata signature
) external {
    require(verifyValidatorSignature(pubkey, signature));
    require(staked[msg.sender] >= MIN_VALIDATOR_STAKE);
    validators.push(Validator({pubkey: pubkey, owner: msg.sender}));
}
```

