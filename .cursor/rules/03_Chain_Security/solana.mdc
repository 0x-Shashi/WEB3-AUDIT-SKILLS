## 8. PDA Bump Seed Canonicalization

```rust
// VULNERABLE - user provides bump (could create multiple valid PDAs)
pub fn set_value(ctx: Context<BumpSeed>, key: u64, bump: u8) -> Result<()> {
    let address = Pubkey::create_program_address(
        &[key.to_le_bytes().as_ref(), &[bump]],  // User-provided bump!
        ctx.program_id
    )?;
    // Different bumps = different addresses for same key
    Ok(())
}

// SECURE - always use canonical bump (find_program_address)
pub fn set_value(ctx: Context<BumpSeed>, key: u64) -> Result<()> {
    let (address, bump) = Pubkey::find_program_address(
        &[key.to_le_bytes().as_ref()],
        ctx.program_id
    );
    // Store bump for later verification
    ctx.accounts.data.bump = bump;
    Ok(())
}

// In Anchor:
#[derive(Accounts)]
#[instruction(key: u64)]
pub struct BumpSeed<'info> {
    #[account(
        seeds = [key.to_le_bytes().as_ref()],
        bump  // Anchor uses canonical bump automatically
    )]
    pub data: Account<'info, Data>,
}
```

