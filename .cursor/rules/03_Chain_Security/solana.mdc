## 2. Missing Owner Checks

```rust
// VULNERABLE - no owner verification
#[derive(Accounts)]
pub struct Withdraw<'info> {
    pub user_account: AccountInfo<'info>,  // Any account could be passed!
}

// SECURE - verify account owner
#[derive(Accounts)]
pub struct Withdraw<'info> {
    #[account(owner = crate::ID)]  // Must be owned by this program
    pub user_account: Account<'info, UserAccount>,
}

// Manual check
if ctx.accounts.account.owner != ctx.program_id {
    return Err(ProgramError::IncorrectProgramId.into());
}
```

