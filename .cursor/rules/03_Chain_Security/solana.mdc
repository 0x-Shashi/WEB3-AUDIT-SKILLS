## 5. Duplicate Mutable Accounts

```rust
// VULNERABLE - same account passed twice
pub fn transfer(ctx: Context<Transfer>) -> Result<()> {
    let user_a = &mut ctx.accounts.user_a;
    let user_b = &mut ctx.accounts.user_b;
    
    user_a.balance -= 100;
    user_b.balance += 100;
    
    // If user_a == user_b, net effect is +100!
    Ok(())
}

// SECURE - verify accounts are different
#[derive(Accounts)]
pub struct Transfer<'info> {
    #[account(
        mut,
        constraint = user_a.key() != user_b.key() @ ErrorCode::DuplicateAccount
    )]
    pub user_a: Account<'info, UserAccount>,
    #[account(mut)]
    pub user_b: Account<'info, UserAccount>,
}
```

