## 7. Arbitrary CPI (Cross-Program Invocation)

```rust
// VULNERABLE - attacker controls target program
#[derive(Accounts)]
pub struct DoCpi<'info> {
    pub token_program: UncheckedAccount<'info>,  // Not validated!
}

pub fn do_cpi(ctx: Context<DoCpi>) -> Result<()> {
    // Attacker can pass malicious program!
    invoke(
        &spl_token::instruction::transfer(...),
        &[...],
    )?;
    Ok(())
}

// SECURE - verify program ID
#[derive(Accounts)]
pub struct DoCpi<'info> {
    pub token_program: Program<'info, Token>,  // Anchor validates
}

// Manual check
if &spl_token::ID != ctx.accounts.token_program.key {
    return Err(ProgramError::IncorrectProgramId);
}
```

