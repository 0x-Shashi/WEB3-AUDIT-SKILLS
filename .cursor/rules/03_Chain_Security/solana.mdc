## 3. Account Data Matching

```rust
// VULNERABLE - doesn't verify account relationships
#[derive(Accounts)]
pub struct Transfer<'info> {
    #[account(mut)]
    pub from: Account<'info, TokenAccount>,
    #[account(mut)]
    pub to: Account<'info, TokenAccount>,
    pub authority: Signer<'info>,
}

// SECURE - verify authority matches
#[derive(Accounts)]
pub struct Transfer<'info> {
    #[account(
        mut,
        has_one = authority  // from.authority must equal authority
    )]
    pub from: Account<'info, TokenAccount>,
    #[account(mut)]
    pub to: Account<'info, TokenAccount>,
    pub authority: Signer<'info>,
}

// Alternative: constraint
#[account(
    mut,
    constraint = from.authority == authority.key()
)]
pub from: Account<'info, TokenAccount>,
```

