## 12. Missing Rent Exemption Check

```rust
// VULNERABLE - account might get garbage collected
pub fn create_account(ctx: Context<Create>) -> Result<()> {
    // Created with insufficient lamports
    Ok(())
}

// SECURE - ensure rent exempt
#[derive(Accounts)]
pub struct Create<'info> {
    #[account(
        init,
        payer = payer,
        space = 8 + MyAccount::INIT_SPACE,
        // Anchor automatically calculates rent
    )]
    pub account: Account<'info, MyAccount>,
    #[account(mut)]
    pub payer: Signer<'info>,
    pub rent: Sysvar<'info, Rent>,
    pub system_program: Program<'info, System>,
}
```

