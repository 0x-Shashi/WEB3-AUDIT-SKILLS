## 9. Account Close / Rebirth Attack

```rust
// VULNERABLE - account not properly closed
pub fn close(ctx: Context<Close>) -> Result<()> {
    let account = ctx.accounts.account.to_account_info();
    
    // Transfer lamports
    **ctx.accounts.recipient.lamports.borrow_mut() += account.lamports();
    **account.lamports.borrow_mut() = 0;
    
    // Data not cleared! Account could be "revived"
    Ok(())
}

// SECURE - use Anchor close constraint
#[derive(Accounts)]
pub struct Close<'info> {
    #[account(
        mut,
        close = recipient  // Transfers lamports & zeros data
    )]
    pub account: Account<'info, MyAccount>,
    #[account(mut)]
    pub recipient: SystemAccount<'info>,
}

// Manual secure close
let mut data = account.try_borrow_mut_data()?;
for byte in data.iter_mut() {
    *byte = 0;
}
// Write closed discriminator
data[..8].copy_from_slice(&CLOSED_ACCOUNT_DISCRIMINATOR);
```

