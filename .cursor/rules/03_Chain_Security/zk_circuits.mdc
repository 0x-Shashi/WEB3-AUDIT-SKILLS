## 9. Input/Output Validation

```rust
// VULNERABLE - Jolt validator uses proof-derived addresses
// Attacker can set output address = input address
io_device.memory_layout.output_start = io_device.memory_layout.input_start;
io_device.memory_layout.termination = io_device.memory_layout.input_start;

// Result: output and termination values forged from input!

// SECURE - validator constructs addresses independently
fn verify(preprocessing: Preprocessing, proof: Proof) {
    // Compute expected memory layout from preprocessing
    let expected_layout = compute_memory_layout(&preprocessing);
    
    // Verify proof uses correct layout
    assert_eq!(proof.memory_layout, expected_layout);
}
```

