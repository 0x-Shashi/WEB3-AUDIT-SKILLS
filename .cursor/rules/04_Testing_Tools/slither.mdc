## Custom Detectors

```python
# detector.py
from slither.detectors.abstract_detector import AbstractDetector, DetectorClassification

class BackdoorDetector(AbstractDetector):
    ARGUMENT = 'backdoor'
    HELP = 'Detect functions with backdoor in name'
    IMPACT = DetectorClassification.HIGH
    CONFIDENCE = DetectorClassification.HIGH
    
    WIKI = 'https://example.com'
    WIKI_TITLE = 'Backdoor Detection'
    WIKI_DESCRIPTION = 'Finds suspicious function names'
    
    def _detect(self):
        results = []
        for contract in self.slither.contracts_derived:
            for f in contract.functions:
                if 'backdoor' in f.name.lower():
                    info = ['Suspicious function: ', f, '\n']
                    results.append(self.generate_result(info))
        return results

# Run: slither . --detect backdoor --solc-remaps @openzeppelin=...
```

