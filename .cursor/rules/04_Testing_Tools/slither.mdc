## Python API Usage

```python
from slither import Slither
from slither.analyses.data_dependency import is_dependent

# Load contract
sl = Slither('MyContract.sol')

# Get compilation unit
cu = sl.compilation_units[0]

# Get contract
contract = cu.get_contract_from_name('MyContract')[0]

# Analyze functions
for func in contract.functions:
    print(f"Function: {func.name}")
    
    # Check for external calls
    for node in func.nodes:
        for ir in node.irs:
            if isinstance(ir, HighLevelCall):
                print(f"  External call: {ir}")
    
    # Check state variable access
    print(f"  Reads: {[v.name for v in func.state_variables_read]}")
    print(f"  Writes: {[v.name for v in func.state_variables_written]}")

# Data dependency analysis
a = contract.get_state_variable_from_name('a')
b = contract.get_state_variable_from_name('b')
print(f"b depends on a: {is_dependent(b, a, contract)}")
```

